# =============================================================================
# AI Knowledge Base — Environment Variables
# Copy this file to .env and fill in real values. setup.sh does the copy for you.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (https://supabase.com -> Project Settings -> API)
# -----------------------------------------------------------------------------
# Used by the NestJS API (server-side, full access via service role).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key   # NEVER expose to the browser

# Used by the Next.js web app (browser-safe, RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# AI Provider — CHAT (any OpenAI-compatible endpoint)
# Default below is Google Gemini (free, no credit card — aistudio.google.com).
# Other examples:
#   OpenAI     base_url=https://api.openai.com/v1            model=gpt-4o-mini
#   Groq       base_url=https://api.groq.com/openai/v1       model=llama-3.3-70b-versatile
#   Ollama     base_url=http://localhost:11434/v1            model=llama3.1
# -----------------------------------------------------------------------------
AI_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CHAT_API_KEY=your-gemini-api-key
AI_CHAT_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# AI Provider — EMBEDDINGS (split from chat: some providers do one but not both)
# IMPORTANT: AI_EMBEDDING_DIMENSIONS MUST match the vector(N) size in the
# document_chunks migration. Default 1024 = Jina jina-embeddings-v3 (free tier,
# no card; migration 20260730000014 sets vector(1024)). Gemini's free tier
# rate-limits embeddings too hard, so chat=Gemini + embeddings=Jina by default.
# -----------------------------------------------------------------------------
AI_EMBEDDING_BASE_URL=https://api.jina.ai/v1
AI_EMBEDDING_API_KEY=your-jina-api-key
AI_EMBEDDING_MODEL=jina-embeddings-v3
AI_EMBEDDING_DIMENSIONS=1024

# -----------------------------------------------------------------------------
# App wiring
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development


# -----------------------------------------------------------------------------
# Admin access (comma-separated emails). These users see the Admin dashboard
# (Settings for SendGrid). The SendGrid API key itself is stored via that UI,
# not here.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=you@example.com
